# Security: uploaded files in this directory (and its symlinked mirror
# public/storage) must NEVER be executable as scripts, no matter what a
# user manages to upload here (chat attachments, product images, etc.).
#
# NOTE (Apache only): .htaccess is ignored entirely by Nginx. If the
# production server runs Nginx, the equivalent block below MUST be added
# to the site's server config instead — see SECURITY_NOTES.md.

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|php\d?|phtml|phar|pl|py|jsp|asp|aspx|cgi|sh|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -ExecCGI -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8
